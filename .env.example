# --- Pflicht ---

# Recall.ai API-Key (https://www.recall.ai -> Dashboard -> API Keys)
# Wichtig: Der Key ist regionsgebunden, RECALL_REGION muss dazu passen.
RECALL_API_KEY=

# OpenAI API-Key (https://platform.openai.com)
OPENAI_API_KEY=

# --- Optional ---

# Recall.ai-Region: us-east-1 | us-west-2 | eu-central-1 | ap-northeast-1
RECALL_REGION=eu-central-1

# Bot-Variante fuer Output Media. web_4_core wird fuer fluessiges Audio empfohlen.
# Moeglich: web | web_4_core
RECALL_BOT_VARIANT=web_4_core

# Realtime-Sprachmodell fuer das Gespraech im Meeting
OPENAI_REALTIME_MODEL=gpt-realtime

# Modell fuer den Abschlussbericht nach dem Meeting
OPENAI_REPORT_MODEL=gpt-5-mini

# Passwort fuer das Dashboard. Wenn gesetzt, verlangen alle Dashboard-APIs
# den Header x-dashboard-key mit diesem Wert. Fuer oeffentlich erreichbare
# Deployments dringend empfohlen (Bot-Starts kosten Geld!).
DASHBOARD_PASSWORD=

# Basis-URL der Seite, die der Bot im Meeting laedt (Agent-Seite).
# Standard: die Netlify-Site-URL. Nur setzen, wenn du lokal mit einem
# Tunnel (z. B. ngrok) entwickelst.
PUBLIC_BASE_URL=
